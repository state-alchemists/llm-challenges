# payments.py

class PaymentGateway:
    def __init__(self):
        self.transactions = {}  # Track transactions to prevent duplicates

    def charge(self, order_id: str, amount: float) -> bool:
        """Charge the user and record the transaction."""
        if order_id not in self.transactions:
            # Mock payment processing logic
            self.transactions[order_id] = amount
            return True
        return False

    def is_charged(self, order_id: str) -> bool:
        """Check if the payment for the given order ID has already been processed."""
        return order_id in self.transactions
```

