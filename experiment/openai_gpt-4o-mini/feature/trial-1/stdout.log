@app.get("/tasks", response_model=List[Task])
async def list_tasks(status: Optional[str] = Query(None), priority: Optional[int] = Query(None), assigned_to: Optional[str] = Query(None), page: int = Query(1), page_size: int = Query(20)):
    # (Filtering code from the previous part remains)
    start = (page - 1) * page_size
    end = start + page_size
    return filtered_tasks[start:end]
