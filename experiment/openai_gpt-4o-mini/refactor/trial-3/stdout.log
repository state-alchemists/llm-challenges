### Proposed Refactoring Breakdown:

- **environment.py**: A utility to load configurations from environment variables.
- **extract_logs**: Function to read and parse log files.
- **transform_data**: Function to organize the extracted data into a suitable format for loading into the database.
- **load_data**: Function to load transformed data into the SQLite database.
- **generate_report**: Function to produce the HTML report.

### Implementation

Here's the complete refactored code:

```python
import os
import re
import datetime
import sqlite3
from typing import List, Dict, Tuple

def get_config() -> Dict[str, str]:
    """Load configuration from environment variables."""
    return {
        "db_path": os.getenv("DB_PATH", "metrics.db"),
        "log_file": os.getenv("LOG_FILE", "server.log"),
        "db_host": os.getenv("DB_HOST", "localhost"),
        "db_port": int(os.getenv("DB_PORT", 5432)),
        "db_user": os.getenv("DB_USER", "admin"),
        "db_pass": os.getenv("DB_PASS", "password123")
    }

def extract_logs(log_file: str) -> List[Dict[str, str]]:
    """Extract log data from the specified log file."""
    log_entries = []
    log_pattern = re.compile(r"(\S+ \S+) (\S+) (.+)")
    
    if os.path.exists(log_file):
        with open(log_file, "r") as f:
            for line in f:
                match = log_pattern.match(line)
                if match:
                    timestamp, level, message = match.groups()
                    if level == "ERROR":
                        log_entries.append({"timestamp": timestamp, "type": "ERR", "message": message})
                    elif "User" in message:
                        uid = re.search(r"User (\d+)", message)
                        if uid:
                            action = message.split(f"User {uid.group(1)} ")[1].strip()
                            log_entries.append({"timestamp": timestamp, "type": "USR", "uid": uid.group(1), "action": action})
                    elif level == "INFO" and "API" in message:
                        endpoint = re.search(r"API (.+?) ", message)
                        duration = re.search(r"took (\d+)ms", message)
                        if endpoint and duration:
                            log_entries.append({"timestamp": timestamp, "type": "API", "endpoint": endpoint.group(1), "duration": int(duration.group(1))})
                    elif level == "WARN":
                        log_entries.append({"timestamp": timestamp, "type": "WARN", "message": message})

    return log_entries

def transform_data(log_entries: List[Dict[str, str]]) -> Tuple[Dict[str, int], Dict[str, List[int]], Dict[str, str]]:
    """Transform log entries into a format suitable for database insertion."""
    error_counts = {}
    api_calls = {}
    sessions = {}

    for entry in log_entries:
        if entry["type"] == "ERR":
            msg = entry["message"]
            error_counts[msg] = error_counts.get(msg, 0) + 1
        elif entry["type"] == "USR":
            uid = entry["uid"]
            action = entry["action"]
            if "logged in" in action:
                sessions[uid] = entry["timestamp"]
            elif "logged out" in action:
                sessions.pop(uid, None)
        elif entry["type"] == "API":
            endpoint = entry["endpoint"]
            api_calls.setdefault(endpoint, []).append(entry["duration"])

    return error_counts, api_calls, sessions

def load_data(db_path: str, error_counts: Dict[str, int], api_calls: Dict[str, List[int]]):
    """Load transformed data into the SQLite database."""
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()

    cursor.execute("CREATE TABLE IF NOT EXISTS errors (dt TEXT, message TEXT, count INTEGER)")
    cursor.execute("CREATE TABLE IF NOT EXISTS api_metrics (dt TEXT, endpoint TEXT, avg_ms REAL)")

    for msg, count in error_counts.items():
        cursor.execute("INSERT INTO errors VALUES (?, ?, ?)", (datetime.datetime.now(), msg, count))

    for endpoint, durations in api_calls.items():
        avg_duration = sum(durations) / len(durations)
        cursor.execute("INSERT INTO api_metrics VALUES (?, ?, ?)", (datetime.datetime.now(), endpoint, avg_duration))

    conn.commit()
    conn.close()

def generate_report(error_counts: Dict[str, int], api_calls: Dict[str, List[int]], active_sessions: Dict[str, str]) -> str:
    """Generate an HTML report from the processed data."""
    report = "<html>\n<head><title>System Report</title></head>\n<body>\n"
    report += "<h1>Error Summary</h1>\n<ul>\n"
    for msg, count in error_counts.items():
        report += f"<li><b>{msg}</b>: {count} occurrences</li>\n"
    report += "</ul>\n"
    
    report += "<h2>API Latency</h2>\n<table border='1'>\n"
    report += "<tr><th>Endpoint</th><th>Avg (ms)</th></tr>\n"
    for endpoint, durations in api_calls.items():
        avg_duration = sum(durations) / len(durations)
        report += f"<tr><td>{endpoint}</td><td>{avg_duration:.1f}</td></tr>\n"
    report += "</table>\n"

    report += "<h2>Active Sessions</h2>\n"
    report += f"<p>{len(active_sessions)} user(s) currently active</p>\n"
    report += "</body>\n</html>"

    return report

def main():
    config = get_config()
    log_entries = extract_logs(config["log_file"])
    error_counts, api_calls, active_sessions = transform_data(log_entries)
    load_data(config["db_path"], error_counts, api_calls)
    
    report = generate_report(error_counts, api_calls, active_sessions)
    with open("report.html", "w") as report_file:
        report_file.write(report)

    print(f"Job finished at {datetime.datetime.now()}")

if __name__ == "__main__":
    main()
```

### Changes Made:

- **Configuration**: Moved hardcoded values to environment variables using a `get_config` function.
- **SQL Handling**: Used parameterized queries in the `load_data` function to prevent SQL injection.
- **Function Decomposition**: Split functionality into `extract_logs`, `transform_data`, `load_data`, and `generate_report`.
- **Log Parsing**: Implemented regex to make log line parsing more reliable.
- **Type Hints and Documentation**: Added type hints and docstrings to all functions for clarity.

Now the script adheres to better security practices, is easier to maintain, and is structured for clarity and reuse.
