```python
import os
import re
import sqlite3
import datetime
from typing import List, Dict, Any

def load_config() -> Dict[str, str]:
    """ Load configuration from environment variables. """
    return {
        "db_path": os.getenv("DB_PATH", "metrics.db"),
        "log_file": os.getenv("LOG_FILE", "server.log"),
        "db_host": os.getenv("DB_HOST", "localhost"),
        "db_port": os.getenv("DB_PORT", "5432"),
        "db_user": os.getenv("DB_USER", "admin"),
        "db_pass": os.getenv("DB_PASS", "password123"),
    }

def parse_log_line(line: str) -> Dict[str, Any]:
    """ Parse a single log line and return a structured dictionary. """
    log_pattern = r'(?P<timestamp>[\d\-]+\s[\d\:]+)\s(?P<level>\w+)\s(?P<message>.*)'
    match = re.match(log_pattern, line.strip())
    if match:
        return match.groupdict()
    return {}

def extract_logs(log_file: str) -> List[Dict[str, Any]]:
    """ Extract logs from the specified log file. """
    log_list = []
    if os.path.exists(log_file):
        with open(log_file, 'r') as f:
            for line in f:
                parsed_line = parse_log_line(line)
                if parsed_line:
                    log_list.append(parsed_line)
    return log_list

def transform_logs(logs: List[Dict[str, Any]]) -> Dict[str, Any]:
    """ Transform raw logs into structured data for reporting. """
    d_list = []
    sessions = {}
    api_calls = []

    for log in logs:
        level = log['level']
        timestamp = log['timestamp']

        if level == "ERROR":
            d_list.append({"d": timestamp, "t": "ERR", "m": log['message']})

        elif level == "INFO" and "User" in log['message']:
            uid = re.search(r'User (\d+)', log['message']).group(1)
            action = log['message'].split(f"User {uid} ")[1].strip()
            if "logged in" in action:
                sessions[uid] = timestamp
            elif "logged out" in action and uid in sessions:
                sessions.pop(uid)
            d_list.append({"d": timestamp, "t": "USR", "u": uid, "a": action})

        elif level == "INFO" and "API" in log['message']:
            endpoint = re.search(r'API (\S+)', log['message']).group(1)
            duration = re.search(r'took (\d+)ms', log['message'])
            dur = int(duration.group(1)) if duration else 0
            api_calls.append({"d": timestamp, "endpoint": endpoint, "ms": dur})

        elif level == "WARN":
            d_list.append({"d": timestamp, "t": "WARN", "m": log['message']})

    return {
        "errors": d_list,
        "sessions": sessions,
        "api_calls": api_calls
    }

def load_data_to_db(db_path: str, transformed_data: Dict[str, Any]) -> None:
    """ Load transformed data into the SQLite database. """
    conn = sqlite3.connect(db_path)
    c = conn.cursor()
    c.execute("CREATE TABLE IF NOT EXISTS errors (dt TEXT, message TEXT, count INTEGER)")
    c.execute("CREATE TABLE IF NOT EXISTS api_metrics (dt TEXT, endpoint TEXT, avg_ms REAL)")

    error_counts = {}
    for error in transformed_data['errors']:
        msg = error['m']
        error_counts[msg] = error_counts.get(msg, 0) + 1

    for msg, count in error_counts.items():
        c.execute("INSERT INTO errors (dt, message, count) VALUES (?, ?, ?)",
                   (datetime.datetime.now(), msg, count))

    endpoint_stats = {}
    for call in transformed_data['api_calls']:
        ep = call['endpoint']
        endpoint_stats.setdefault(ep, []).append(call['ms'])

    for ep, times in endpoint_stats.items():
        avg = sum(times) / len(times)
        c.execute("INSERT INTO api_metrics (dt, endpoint, avg_ms) VALUES (?, ?, ?)",
                   (datetime.datetime.now(), ep, avg))

    conn.commit()
    conn.close()

def generate_report(transformed_data: Dict[str, Any]) -> str:
    """ Generate an HTML report from the transformed data. """
    report = "<html>\n<head><title>System Report</title></head>\n<body>\n"
    report += "<h1>Error Summary</h1>\n<ul>\n"
    
    error_counts = {}
    for error in transformed_data['errors']:
        msg = error['m']
        error_counts[msg] = error_counts.get(msg, 0) + 1

    for err_msg, count in error_counts.items():
        report += f"<li><b>{err_msg}</b>: {count} occurrences</li>\n"
    report += "</ul>\n"

    report += "<h2>API Latency</h2>\n<table border='1'>\n"
    report += "<tr><th>Endpoint</th><th>Avg (ms)</th></tr>\n"
    endpoint_stats = {}
    for call in transformed_data['api_calls']:
        ep = call['endpoint']
        endpoint_stats.setdefault(ep, []).append(call['ms'])

    for ep, times in endpoint_stats.items():
        avg = sum(times) / len(times)
        report += f"<tr><td>{ep}</td><td>{avg:.1f}</td></tr>\n"
    report += "</table>\n"

    report += "<h2>Active Sessions</h2>\n"
    report += f"<p>{len(transformed_data['sessions'])} user(s) currently active</p>\n"
    report += "</body>\n</html>"
    
    return report

def save_report(report: str, filepath: str) -> None:
    """ Save the generated report to a file. """
    with open(filepath, "w") as f:
        f.write(report)

def main() -> None:
    """ Main function to orchestrate ETL and report generation. """
    config = load_config()
    logs = extract_logs(config['log_file'])
    transformed_data = transform_logs(logs)
    load_data_to_db(config['db_path'], transformed_data)
    report = generate_report(transformed_data)
    save_report(report, "report.html")
    print("Job finished at " + str(datetime.datetime.now()))

if __name__ == "__main__":
    main()
```

### Key Changes Made:
1. **Environment Variables**: Configuration parameters are loaded from environment variables, making it easy to change without modifying the code.
2. **Parameterized Queries**: SQL queries are now parameterized to prevent SQL injection attacks.
3. **Refactored Functions**: The logic is organized into smaller, well-named functions aligned with the ETL process.
4. **Regex for Parsing**: Regular expressions are used for log line parsing to improve robustness.
5. **Type Hints and Docstrings**: Added type hints and docstrings for better readability and maintainability.

This refactored code should be more secure, maintainable, and easier to understand. Let me know if you need further assistance or adjustments!
