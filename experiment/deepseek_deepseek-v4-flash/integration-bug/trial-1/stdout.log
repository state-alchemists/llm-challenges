[0m  [2mfrom inventory import Inventory
[0m  [2mfrom payments import PaymentGateway
[0m  [2m
[0m  [2m
[0m  [2masync def checkout(
[0m  [2m    order_id: str,
[0m  [2m    quantity: int,
