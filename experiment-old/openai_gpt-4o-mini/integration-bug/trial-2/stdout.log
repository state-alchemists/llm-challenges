### Modifying `inventory.py`

```python
# inventory.py

class Inventory:
    def __init__(self):
        self.stock = {}

    def reserve(self, item_id, quantity):
        """Reserve items to temporarily hold stock for a transaction."""
        if self.stock.get(item_id, 0) < quantity:
            return False
        self.stock[item_id] -= quantity
        return True

    def release(self, item_id, quantity):
        """Release stock back to inventory if transaction fails."""
        self.stock[item_id] += quantity

    def check_availability(self, item_id, quantity):
        """Check if the items are available in stock."""
        return self.stock.get(item_id, 0) >= quantity
```

### Modifying `payments.py`

```python
# payments.py

class PaymentGateway:
    def __init__(self):
        self.payments = {}

    def charge(self, order_id, amount):
        """Charge the customer and track the payment by order ID."""
        if order_id in self.payments:
            return False  # Prevent multiple charges for the same order
        
        # Simulate charging
        self.payments[order_id] = amount  # Track payment
        return True

    def is_payment_successful(self, order_id):
        """Check if payment was successful."""
        return order_id in self.payments
```

### Modifying `checkout.py`

```python
# checkout.py

from inventory import Inventory
from payments import PaymentGateway

def checkout(user_id, item_id, quantity, payment_info):
    inventory = Inventory()
    payment_gateway = PaymentGateway()
    
    if not inventory.check_availability(item_id, quantity):
        print("Sorry, the item is out of stock.")
        return False

    # Reserve inventory first
    if not inventory.reserve(item_id, quantity):
        print("Could not reserve item.")
        return False

    # Try charging the user
    order_id = f"{user_id}-{item_id}"
    charge_success = payment_gateway.charge(order_id, payment_info['amount'])

    if not charge_success:
        print("Payment has already been processed for this order.")
        inventory.release(item_id, quantity)  # Release the reserved stock
        return False

    if not payment_gateway.is_payment_successful(order_id):
        print("Payment failed. Releasing inventory.")
        inventory.release(item_id, quantity)  # Release stock on failure
        return False

    print("Order successful!")
    return True
```

In this updated logic:
- The inventory is reserved before attempting to charge the payment.
- If payment fails, inventory is released back.
- Each order is tracked to prevent multiple charges.
- Successful orders ensure that inventory management and payment are tightly coupled to avoid the issues you reported.

