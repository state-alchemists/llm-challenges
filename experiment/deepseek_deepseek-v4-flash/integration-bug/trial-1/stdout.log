[0m  [2m
[0m  [2mwith open("inventory.py") as f: inv_src = f.read()
[0m  [2mwith open("checkout.py") as f: checkout_src = f.read()
[0m  [2m
[0m  [2masync def run_one(seed):
[0m  [2m    random.seed(seed)
