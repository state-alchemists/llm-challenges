# inventory.py

class Inventory:
    def __init__(self):
        self.stock = {}  # Example: {'item1': 10, 'item2': 0}

    def is_available(self, item_id: str, quantity: int) -> bool:
        """Check if the requested quantity is available."""
        return self.stock.get(item_id, 0) >= quantity

    def reserve(self, item_id: str, quantity: int) -> bool:
        """Reserve a specified quantity of an item."""
        if self.is_available(item_id, quantity):
            self.stock[item_id] -= quantity
            return True
        return False

    def release(self, item_id: str, quantity: int):
        """Release previously reserved items back to inventory."""
        self.stock[item_id] += quantity
```

#### 2. Changes to `payments.py`

Add transaction management to ensure no double charges occur and that payments are processed only for available items.

