class Checkout:
    def __init__(self, inventory: Inventory, payment_gateway: PaymentGateway):
        self.inventory = inventory
        self.payment_gateway = payment_gateway

    def process_order(self, item_id: str, quantity: int, user_id: str) -> bool:
        order_id = f"{user_id}:{item_id}"
        
        # Check if the item is available
        if not self.inventory.is_available(item_id, quantity):
            print(f"Order failed: {item_id} is out of stock.")
            return False

        # Reserve the inventory
        if not self.inventory.reserve(item_id, quantity):
            print(f"Failed to reserve items in inventory for {item_id}.")
            return False
        
        # Attempt to charge the user
        if self.payment_gateway.charge(order_id, self.calculate_price(item_id, quantity)):
            print(f"Order successful: {item_id} charged for user {user_id}.")
            return True
        
        # Release inventory if payment fails
        self.inventory.release(item_id, quantity)
        print(f"Payment failed for order {order_id}, inventory released.")
        return False

    def calculate_price(self, item_id: str, quantity: int) -> float:
