To refactor the `pipeline.py` script, we'll structure it to separate the different stages of processing using the Extract, Transform, Load (ETL) pattern. We'll also replace hardcoded strings with environment variables, implement parameterized SQL queries to prevent injection risks, and improve log parsing reliability with regex.

Here's the refactored script, renamed as `pipeline_refactored.py`:

```python
import os
import sqlite3
import re
import datetime
from typing import List, Dict, Tuple


def extract_log_data(log_file_path: str) -> Tuple[List[Dict], Dict, List[Dict]]:
    """Extracts data from log files."""
    error_entries = []
    sessions = {}
    api_calls = []

    log_pattern = re.compile(r"(\d+-\d+-\d+ \d+:\d+:\d+) (\w+) (.+)")

    with open(log_file_path, "r") as file:
        for line in file:
            match = log_pattern.match(line)
            if not match:
                continue

            dt, lvl, message = match.groups()
            if lvl == "ERROR":
                error_entries.append({"d": dt, "t": "ERR", "m": message})
            elif lvl == "INFO" and "User" in message:
                user_match = re.search(r"User (\d+) (.+)", message)
                if user_match:
                    uid, action = user_match.groups()
                    if "logged in" in action:
                        sessions[uid] = dt
                    elif "logged out" in action and uid in sessions:
                        sessions.pop(uid)
                    error_entries.append({"d": dt, "t": "USR", "u": uid, "a": action})
            elif lvl == "INFO" and "API" in message:
                api_match = re.search(r"API (/[^ ]+) took (\d+)ms", message)
                if api_match:
                    endpoint, dur = api_match.groups()
                    api_calls.append({"d": dt, "endpoint": endpoint, "ms": int(dur)})

    return error_entries, sessions, api_calls


def transform_data(
    error_entries: List[Dict], api_calls: List[Dict]
) -> Tuple[Dict[str, int], Dict[str, float]]:
    """Transforms raw data into summarized reports."""
    error_summary = {}
    for entry in error_entries:
        if entry["t"] == "ERR":
            message = entry["m"]
            if message in error_summary:
                error_summary[message] += 1
            else:
                error_summary[message] = 1

    endpoint_stats = {}
    for call in api_calls:
        ep = call["endpoint"]
        if ep not in endpoint_stats:
            endpoint_stats[ep] = [call["ms"]]
        else:
            endpoint_stats[ep].append(call["ms"])

    api_latency = {
        ep: sum(times) / len(times) for ep, times in endpoint_stats.items()
    }

    return error_summary, api_latency


def load_data(
    db_path: str, error_summary: Dict[str, int], api_latency: Dict[str, float]
):
    """Loads the transformed data into a SQLite database."""
    conn = sqlite3.connect(db_path)
    c = conn.cursor()

    c.execute(
        "CREATE TABLE IF NOT EXISTS errors (dt TEXT, message TEXT, count INTEGER)"
    )
    c.execute(
        "CREATE TABLE IF NOT EXISTS api_metrics (dt TEXT, endpoint TEXT, avg_ms REAL)"
    )

    now = datetime.datetime.now().isoformat()

    for msg, count in error_summary.items():
        c.execute(
            "INSERT INTO errors (dt, message, count) VALUES (?, ?, ?)",
            (now, msg, count),
        )

    for ep, avg in api_latency.items():
        c.execute(
            "INSERT INTO api_metrics (dt, endpoint, avg_ms) VALUES (?, ?, ?)",
            (now, ep, avg),
        )

    conn.commit()
    conn.close()


def generate_report(
    file_path: str, error_summary: Dict[str, int], api_latency: Dict[str, float], active_sessions: int
):
    """Generates an HTML report from the data."""
    out = "<html>\n<head><title>System Report</title></head>\n<body>\n"
    out += "<h1>Error Summary</h1>\n<ul>\n"
    for err_msg, count in error_summary.items():
        out += f"<li><b>{err_msg}</b>: {count} occurrences</li>\n"
    out += "</ul>\n"

    out += "<h2>API Latency</h2>\n<table border='1'>\n"
    out += "<tr><th>Endpoint</th><th>Avg (ms)</th></tr>\n"
    for ep, avg in api_latency.items():
        out += f"<tr><td>{ep}</td><td>{round(avg, 1)}</td></tr>\n"
    out += "</table>\n"

    out += f"<h2>Active Sessions</h2>\n<p>{active_sessions} user(s) currently active</p>\n"
    out += "</body>\n</html>"

    with open(file_path, "w") as f:
        f.write(out)


def main():
    db_path = os.environ.get("DB_PATH", "metrics.db")
    log_file_path = os.environ.get("LOG_FILE_PATH", "server.log")

    error_entries, sessions, api_calls = extract_log_data(log_file_path)
    error_summary, api_latency = transform_data(error_entries, api_calls)
    load_data(db_path, error_summary, api_latency)
    generate_report("report.html", error_summary, api_latency, len(sessions))

    print(f"Job finished at {datetime.datetime.now()}")


if __name__ == "__main__":
    main()
```

### Key Changes:
1. **Environment Variables**: Replaced hardcoded values with environment variables using `os.environ.get()`.
2. **SQL Injection Prevention**: Used parameterized queries (`?`) for database operations to avoid SQL injection risks.
3. **ETL Structure**: Split the data processing into `extract_log_data`, `transform_data`, and `load_data` functions.
4. **Regex for Log Parsing**: Used regular expressions to more reliably parse log lines.
5. **Type Hints and Documentation**: Added type hints and docstrings to improve readability and maintainability.

The report is still generated with the same information as before, encapsulated through organized functions for better clarity and security.
