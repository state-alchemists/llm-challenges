```python
import os
import re
import sqlite3
import datetime
from typing import List, Dict, Any

# Fetch config from environment variables
DB_PATH = os.getenv("DB_PATH", "metrics.db")
LOG_FILE = os.getenv("LOG_FILE", "server.log")
DB_HOST = os.getenv("DB_HOST", "localhost")
DB_PORT = int(os.getenv("DB_PORT", "5432"))
DB_USER = os.getenv("DB_USER", "admin")
DB_PASS = os.getenv("DB_PASS", "password123")

def parse_log_line(line: str) -> Dict[str, Any]:
    """Parse a single log line and return a structured dictionary."""
    pattern = r'(?P<timestamp>[\d\-\s:]+) (?P<level>\w+) (?P<message>.*)'
    match = re.match(pattern, line)
    if match:
        return match.groupdict()
    return {}

def extract_errors_and_sessions(log_lines: List[str]) -> (List[Dict[str, str]], Dict[str, str]):
    """Extract error messages and user sessions from the log lines."""
    d_list = []
    sessions = {}
    
    for line in log_lines:
        parsed_line = parse_log_line(line)
        if parsed_line:
            level = parsed_line['level']
            dt = parsed_line['timestamp']

            if level == "ERROR":
                d_list.append({"d": dt, "t": "ERR", "m": parsed_line['message']})
            elif level == "INFO":
                if "User" in parsed_line['message']:
                    uid = re.search(r'User (\d+)', parsed_line['message']).group(1)
                    action = parsed_line['message'].split(f'User {uid} ')[-1].strip()
                    if "logged in" in action:
                        sessions[uid] = dt
                    elif "logged out" in action and uid in sessions:
                        sessions.pop(uid)
                    d_list.append({"d": dt, "t": "USR", "u": uid, "a": action})
                elif "API" in parsed_line['message']:
                    endpoint = re.search(r'API (\S+)', parsed_line['message']).group(1)
                    dur = re.search(r'took (\d+)ms', parsed_line['message'])
                    duration = int(dur.group(1)) if dur else 0
                    d_list.append({"d": dt, "endpoint": endpoint, "ms": duration})
    return d_list, sessions

def load_errors_to_db(errors: List[Dict[str, str]]) -> None:
    """Load error data into the SQLite database."""
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("CREATE TABLE IF NOT EXISTS errors (dt TEXT, message TEXT, count INTEGER)")

    error_counts = {}
    for error in errors:
        msg = error['m']
        error_counts[msg] = error_counts.get(msg, 0) + 1

    for msg, count in error_counts.items():
        c.execute("INSERT INTO errors VALUES (?, ?, ?)",
                  (datetime.datetime.now().isoformat(), msg, count))

    conn.commit()
    conn.close()

def load_api_metrics_to_db(api_calls: List[Dict[str, Any]]) -> None:
    """Load API call metrics into the SQLite database."""
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("CREATE TABLE IF NOT EXISTS api_metrics (dt TEXT, endpoint TEXT, avg_ms REAL)")

    endpoint_stats = {}
    for call in api_calls:
        ep = call['endpoint']
        if ep not in endpoint_stats:
            endpoint_stats[ep] = []
        endpoint_stats[ep].append(call['ms'])

    for ep, times in endpoint_stats.items():
        avg = sum(times) / len(times)
        c.execute("INSERT INTO api_metrics VALUES (?, ?, ?)",
                  (datetime.datetime.now().isoformat(), ep, avg))

    conn.commit()
    conn.close()

def generate_report(errors: List[Dict[str, str]], sessions: Dict[str, str]) -> None:
    """Generate an HTML report based on the processed data."""
    out = "<html>\n<head><title>System Report</title></head>\n<body>\n"
    out += "<h1>Error Summary</h1>\n<ul>\n"
    
    for err in errors:
        out += f"<li><b>{err['m']}</b>: {err['count']} occurrences</li>\n"
    out += "</ul>\n"

    out += "<h2>API Latency</h2>\n<table border='1'>\n"
    out += "<tr><th>Endpoint</th><th>Avg (ms)</th></tr>\n"
    
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT endpoint, avg_ms FROM api_metrics")
    for endpoint, avg_ms in c.fetchall():
        out += f"<tr><td>{endpoint}</td><td>{round(avg_ms, 1)}</td></tr>\n"
    out += "</table>\n"

    out += "<h2>Active Sessions</h2>\n"
    out += f"<p>{len(sessions)} user(s) currently active</p>\n"
    out += "</body>\n</html>"

    with open("report.html", "w") as f:
        f.write(out)

def main() -> None:
    """Main function to process logs and produce the report."""
    if not os.path.exists(LOG_FILE):
        with open(LOG_FILE, "w") as f:
            f.write("2024-01-01 12:00:00 INFO User 42 logged in\n")
            f.write("2024-01-01 12:05:00 ERROR Database timeout\n")
            f.write("2024-01-01 12:08:00 INFO API /users/profile took 250ms\n")
            f.write("2024-01-01 12:09:00 WARN Memory usage at 87%\n")
            f.write("2024-01-01 12:10:00 INFO User 42 logged out\n")

    with open(LOG_FILE, "r") as f:
        log_lines = f.readlines()

    errors, sessions = extract_errors_and_sessions(log_lines)
    load_errors_to_db(errors)
    load_api_metrics_to_db([call for call in errors if 'endpoint' in call])
    generate_report(errors, sessions)

    print("Job finished at " + str(datetime.datetime.now()))

if __name__ == "__main__":
    main()
```

### Changes Made
- **Environment Variables**: Now all paths and credentials are fetched using `os.getenv`.
- **Parameterization**: Used parameterized queries for database inserts.
- **ETL Structure**: The monolithic function was broken down into `extract_errors_and_sessions`, `load_errors_to_db`, `load_api_metrics_to_db`, and `generate_report`.
- **Regex Usage**: Log parsing is done using regex to manage fragility.
- **Type Hints and Docstrings**: Added throughout for better clarity and tooling support.

