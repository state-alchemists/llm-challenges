[0m  [2m        func = node.func
[0m  [2m        if isinstance(func, ast.Attribute) and func.attr in CONCURRENCY_PRIMITIVES:
[0m  [2m            return True
[0m  [2m        if isinstance(func, ast.Name) and func.id in CONCURRENCY_PRIMITIVES:
[0m  [2m            return True
