```python
import os
import re
import datetime
import sqlite3
from typing import List, Dict, Any

def load_config() -> None:
    """Load necessary configuration from environment variables."""
    global DB_PATH, LOG_FILE, DB_HOST, DB_PORT, DB_USER, DB_PASS
    DB_PATH = os.getenv('DB_PATH', 'metrics.db')
    LOG_FILE = os.getenv('LOG_FILE', 'server.log')
    DB_HOST = os.getenv('DB_HOST', 'localhost')
    DB_PORT = int(os.getenv('DB_PORT', 5432))
    DB_USER = os.getenv('DB_USER', 'admin')
    DB_PASS = os.getenv('DB_PASS', 'password123')

def parse_log_line(line: str) -> Dict[str, Any]:
    """Parse a log line using regex and return its components.

    Args:
        line (str): A single line from the log file.
        
    Returns:
        dict: Parsed components from the log line, or None if not matched.
    """
    log_pattern = re.compile(r'(?P<timestamp>[\d\-]+\s[\d:]+)\s(?P<level>\w+)(?:\s(?P<message>.*))?')
    match = log_pattern.match(line)
    
    if not match:
        return None

    return match.groupdict()

def process_logs() -> List[Dict[str, Any]]:
    """Process logs from the log file and return structured data.

    Returns:
        List[Dict[str, Any]]: List of extracted log information.
    """
    log_data = []
    sessions = {}
    api_calls = []

    if os.path.exists(LOG_FILE):
        with open(LOG_FILE, "r") as f:
            for line in f:
                parsed_line = parse_log_line(line.strip())
                if not parsed_line:
                    continue

                level = parsed_line['level']
                dt = parsed_line['timestamp']

                if level == "ERROR":
                    msg = parsed_line['message'] or ""
                    log_data.append({"d": dt, "t": "ERR", "m": msg.strip()})
                elif level == "INFO":
                    if "User" in parsed_line['message']:
                        uid = re.search(r'User (\d+)', parsed_line['message'])
                        if uid:
                            uid = uid.group(1)
                            action = re.sub(f'User {uid} ', '', parsed_line['message'])
                            if "logged in" in action:
                                sessions[uid] = dt
                            elif "logged out" in action and uid in sessions:
                                sessions.pop(uid)
                            log_data.append({"d": dt, "t": "USR", "u": uid, "a": action})
                    elif "API" in parsed_line['message']:
                        endpoint = re.search(r'API (\S+)', parsed_line['message'])
                        dur = re.search(r'took (\d+)ms', parsed_line['message'])
                        if endpoint and dur:
                            api_calls.append({"d": dt, "endpoint": endpoint.group(1), "ms": int(dur.group(1))})
                elif level == "WARN":
                    msg = parsed_line['message'] or ""
                    log_data.append({"d": dt, "t": "WARN", "m": msg.strip()})

    return log_data, sessions, api_calls

def save_to_db(log_data: List[Dict[str, Any]], api_calls: List[Dict[str, Any]]) -> None:
    """Save processed log data to the SQLite database.

    Args:
        log_data (List[Dict[str, Any]]): The processed log data.
        api_calls (List[Dict[str, Any]]): The processed API calls.
    """
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("CREATE TABLE IF NOT EXISTS errors (dt TEXT, message TEXT, count INTEGER)")
    c.execute("CREATE TABLE IF NOT EXISTS api_metrics (dt TEXT, endpoint TEXT, avg_ms REAL)")

    error_count = {}
    for entry in log_data:
        if entry["t"] == "ERR":
            msg = entry["m"]
            error_count[msg] = error_count.get(msg, 0) + 1

    for msg, count in error_count.items():
        c.execute("INSERT INTO errors (dt, message, count) VALUES (?, ?, ?)",
                  (datetime.datetime.now(), msg, count))

    endpoint_stats = {}
    for call in api_calls:
        ep = call["endpoint"]
        endpoint_stats.setdefault(ep, []).append(call["ms"])

    for ep, times in endpoint_stats.items():
        avg = sum(times) / len(times)
        c.execute("INSERT INTO api_metrics (dt, endpoint, avg_ms) VALUES (?, ?, ?)",
                  (datetime.datetime.now(), ep, avg))

    conn.commit()
    conn.close()

def generate_report(log_data: List[Dict[str, Any]], api_calls: List[Dict[str, Any]], sessions: Dict[str, str]) -> None:
    """Generate an HTML report from the processed data.

    Args:
        log_data (List[Dict[str, Any]]): The processed log data.
        api_calls (List[Dict[str, Any]]): The processed API calls.
        sessions (Dict[str, str]): Active user sessions.
    """
    error_count = {}
    for entry in log_data:
        if entry["t"] == "ERR":
            msg = entry["m"]
            error_count[msg] = error_count.get(msg, 0) + 1

    endpoint_stats = {}
    for call in api_calls:
        ep = call["endpoint"]
        endpoint_stats.setdefault(ep, []).append(call["ms"])
    
    report = "<html>\n<head><title>System Report</title></head>\n<body>\n"
    report += "<h1>Error Summary</h1>\n<ul>\n"
    for err_msg, count in error_count.items():
        report += f"<li><b>{err_msg}</b>: {count} occurrences</li>\n"
    report += "</ul>\n"

    report += "<h2>API Latency</h2>\n<table border='1'>\n"
    report += "<tr><th>Endpoint</th><th>Avg (ms)</th></tr>\n"
    for ep, times in endpoint_stats.items():
        avg = sum(times) / len(times)
        report += f"<tr><td>{ep}</td><td>{round(avg, 1)}</td></tr>\n"
    report += "</table>\n"

    report += "<h2>Active Sessions</h2>\n"
    report += f"<p>{len(sessions)} user(s) currently active</p>\n"
    report += "</body>\n</html>"

    with open("report.html", "w") as f:
        f.write(report)

def main() -> None:
    """Main function to orchestrate log processing."""
    load_config()
    log_data, sessions, api_calls = process_logs()
    save_to_db(log_data, api_calls)
    generate_report(log_data, api_calls, sessions)
    print(f"Job finished at {datetime.datetime.now()}")

if __name__ == "__main__":
    if not os.path.exists(LOG_FILE):
        with open(LOG_FILE, "w") as f:
            f.write("2024-01-01 12:00:00 INFO User 42 logged in\n")
            f.write("2024-01-01 12:05:00 ERROR Database timeout\n")
            f.write("2024-01-01 12:05:05 ERROR Database timeout\n")
            f.write("2024-01-01 12:08:00 INFO API /users/profile took 250ms\n")
            f.write("2024-01-01 12:09:00 WARN Memory usage at 87%\n")
            f.write("2024-01-01 12:10:00 INFO User 42 logged out\n")
    main()
```

### Changes Made:
1. **Environment Variables:** 
   - All configuration values are fetched from environment variables using `os.getenv()`.
2. **SQL Injection Prevention:**
   - Used parameterized queries instead of string formatting for SQL command execution.
3. **Code Organization:**
   - Functions were divided based on the ETL process: `load_config`, `parse_log_line`, `process_logs`, `save_to_db`, and `generate_report`.
4. **Log Parsing:**
   - Implemented regex for log line parsing within the `parse_log_line` function.
5. **Type Hints and Docstrings:**
   - Added type hints and docstrings to functions to enhance code readability.

The output HTML file (`report.html`) remains structurally unchanged but is generated through the streamlined logic.
