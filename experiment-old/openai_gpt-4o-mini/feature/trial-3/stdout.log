@app.delete("/tasks/{task_id}", status_code=status.HTTP_204_NO_CONTENT)
def delete_task(task_id: int, api_key: str = Depends(require_api_key)):
    task = get_task_by_id(task_id)  # Retrieve the task by ID
    if not task:
        raise HTTPException(status_code=404, detail="Task not found")
    delete_task_by_id(task_id)  # Assume a method to delete the task from the database
