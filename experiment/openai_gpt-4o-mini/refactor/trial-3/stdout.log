```python
import os
import re
import datetime
import sqlite3
from typing import List, Dict, Tuple

# Load configuration from environment variables
DB_PATH = os.getenv("DB_PATH", "metrics.db")
LOG_FILE = os.getenv("LOG_FILE", "server.log")
DB_HOST = os.getenv("DB_HOST", "localhost")
DB_PORT = int(os.getenv("DB_PORT", 5432))
DB_USER = os.getenv("DB_USER", "admin")
DB_PASS = os.getenv("DB_PASS", "password123")

def parse_log_line(line: str) -> Dict[str, str]:
    """Parse a line from the log file into a structured dictionary."""
    log_pattern = re.compile(r'(?P<date>\S+ \S+) (?P<level>\S+) (?P<message>.*)')
    match = log_pattern.match(line)
    if match:
        return match.groupdict()
    return {}

def extract_error_messages(log_lines: List[str]) -> List[Dict[str, str]]:
    """Extract error messages from the log lines."""
    errors = []
    for line in log_lines:
        parsed_line = parse_log_line(line)
        if parsed_line and parsed_line['level'] == 'ERROR':
            errors.append({
                "d": parsed_line['date'],
                "t": "ERR",
                "m": parsed_line['message']
            })
    return errors

def extract_user_sessions(log_lines: List[str], sessions: Dict[str, str]) -> List[Dict[str, str]]:
    """Extract user session information from the log lines."""
    users = []
    for line in log_lines:
        parsed_line = parse_log_line(line)
        if parsed_line and parsed_line['level'] == 'INFO':
            if "User" in parsed_line['message']:
                components = parsed_line['message'].split(" ")
                uid = components[1]
                action = " ".join(components[2:])
                if "logged in" in action:
                    sessions[uid] = parsed_line['date']
                elif "logged out" in action and uid in sessions:
                    sessions.pop(uid)
                users.append({"d": parsed_line['date'], "t": "USR", "u": uid, "a": action})
    return users

def extract_api_calls(log_lines: List[str]) -> List[Dict[str, str]]:
    """Extract API calls and their durations from the log lines."""
    api_calls = []
    for line in log_lines:
        parsed_line = parse_log_line(line)
        if parsed_line and parsed_line['level'] == 'INFO' and "API" in parsed_line['message']:
            components = parsed_line['message'].split(" ")
            endpoint = components[1]
            dur = int(re.search(r'took (\d+)ms', parsed_line['message']).group(1)) if 'took' in parsed_line['message'] else 0
            api_calls.append({"d": parsed_line['date'], "endpoint": endpoint, "ms": dur})
    return api_calls

def write_to_database(errors: List[Dict[str, str]], api_calls: List[Dict[str, str]], sessions: Dict[str, str]) -> None:
    """Write extracted data into the SQLite database."""
    conn = sqlite3.connect(DB_PATH)
    with conn:
        c = conn.cursor()
        c.execute("CREATE TABLE IF NOT EXISTS errors (dt TEXT, message TEXT, count INTEGER)")
        c.execute("CREATE TABLE IF NOT EXISTS api_metrics (dt TEXT, endpoint TEXT, avg_ms REAL)")

        # Insert error messages
        error_count = {}
        for error in errors:
            msg = error["m"]
            error_count[msg] = error_count.get(msg, 0) + 1

        for msg, count in error_count.items():
            c.execute("INSERT INTO errors (dt, message, count) VALUES (?, ?, ?)",
                       (datetime.datetime.now(), msg, count))

        # Insert API metrics
        endpoint_stats = {}
        for call in api_calls:
            endpoint = call["endpoint"]
            endpoint_stats.setdefault(endpoint, []).append(call["ms"])

        for endpoint, times in endpoint_stats.items():
            avg = sum(times) / len(times)
            c.execute("INSERT INTO api_metrics (dt, endpoint, avg_ms) VALUES (?, ?, ?)",
                       (datetime.datetime.now(), endpoint, avg))

def generate_report(errors: List[Dict[str, str]], api_calls: List[Dict[str, str]], sessions: Dict[str, str]) -> None:
    """Generate an HTML report from the extracted data."""
    out = "<html>\n<head><title>System Report</title></head>\n<body>\n"
    out += "<h1>Error Summary</h1>\n<ul>\n"
    error_count = {}
    for error in errors:
        msg = error["m"]
        error_count[msg] = error_count.get(msg, 0) + 1
    for err_msg, count in error_count.items():
        out += f"<li><b>{err_msg}</b>: {count} occurrences</li>\n"
    out += "</ul>\n"

    out += "<h2>API Latency</h2>\n<table border='1'>\n<tr><th>Endpoint</th><th>Avg (ms)</th></tr>\n"
    api_metrics = {}
    for call in api_calls:
        endpoint = call["endpoint"]
        api_metrics[endpoint] = api_metrics.get(endpoint, []) + [call["ms"]]
    for ep, times in api_metrics.items():
        avg = sum(times) / len(times) if times else 0
        out += f"<tr><td>{ep}</td><td>{avg:.1f}</td></tr>\n"
    out += "</table>\n"

    out += f"<h2>Active Sessions</h2>\n<p>{len(sessions)} user(s) currently active</p>\n</body>\n</html>"

    with open("report.html", "w") as f:
        f.write(out)

def proc_data() -> None:
    """Main processing function to extract, transform, and load logs."""
    if not os.path.exists(LOG_FILE):
        with open(LOG_FILE, "w") as f:
            f.write("2024-01-01 12:00:00 INFO User 42 logged in\n")
            f.write("2024-01-01 12:05:00 ERROR Database timeout\n")
            f.write("2024-01-01 12:05:05 ERROR Database timeout\n")
            f.write("2024-01-01 12:08:00 INFO API /users/profile took 250ms\n")
            f.write("2024-01-01 12:09:00 WARN Memory usage at 87%\n")
            f.write("2024-01-01 12:10:00 INFO User 42 logged out\n")

    with open(LOG_FILE, "r") as f:
        log_lines = f.readlines()

    sessions = {}
    errors = extract_error_messages(log_lines)
    extract_user_sessions(log_lines, sessions)
    api_calls = extract_api_calls(log_lines)

    write_to_database(errors, api_calls, sessions)
    generate_report(errors, api_calls, sessions)

    print("Job finished at " + str(datetime.datetime.now()))

if __name__ == "__main__":
    proc_data()
```

