[0m  [2mimport asyncio
[0m  [2m
[0m  [2m
[0m  [2mclass Inventory:
[0m  [2m    def __init__(self, stock: int):
[0m  [2m        self._stock = stock
[0m  [2m        self._lock = asyncio.Lock()
[0m  [2m
[0m  [2m    async def check_stock(self, quantity: int) -> bool:
[0m  [2m        await asyncio.sleep(0.02)
[0m  [2m        return self._stock >= quantity
[0m  [2m
[0m  [2m    async def reserve(self, quantity: int) -> bool:
[0m  [2m        """Atomically check and hold stock. Returns True if reserved."""
[0m  [2m        async with self._lock:
[0m  [2m            await asyncio.sleep(0.02)
[0m  [2m            if self._stock >= quantity:
[0m  [2m                self._stock -= quantity
[0m  [2m                return True
[0m  [2m            return False
[0m  [2m
[0m  [2m    async def release(self, quantity: int) -> None:
[0m  [2m        """Return previously reserved stock to inventory."""
[0m  [2m        async with self._lock:
[0m  [2m            await asyncio.sleep(0.01)
[0m  [2m            self._stock += quantity
[0m  [2m
[0m  [2m    async def decrement(self, quantity: int) -> bool:
[0m  [2m        await asyncio.sleep(0.02)
[0m  [2m        if self._stock >= quantity:
[0m  [2m            self._stock -= quantity
[0m  [2m            return True
[0m  [2m        return False
[0m  [2m
[0m  [2m    async def increment(self, quantity: int) -> None:
[0m  [2m        await asyncio.sleep(0.01)
[0m  [2m        self._stock += quantity
[0m  [2m
[0m  [2m    @property
[0m  [2m    def stock(self) -> int:
[0m  [2m        return self._stock
