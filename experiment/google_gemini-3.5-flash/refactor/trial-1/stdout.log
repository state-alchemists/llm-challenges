[0m  [2m+
[0m  [2m+    # Regex patterns for parsing log prefix, user, and API details
[0m  [2m+    log_pattern = re.compile(
[0m  [2m+        r"^(?P<dt>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}) (?P<lvl>INFO|ERROR|WARN) (?P<msg>.*)$"
