Here's a refactored version of the `pipeline.py` script, addressing all the specified issues. The script now uses environment variables for configuration, parameterized SQL queries to prevent SQL injection, breaks down functionality into smaller functions, utilizes regex for log parsing, and includes type hints and docstrings.

```python
import datetime
import os
import re
import sqlite3
from typing import Dict, List

def get_env_variables() -> Dict[str, str]:
    """Retrieve environment variables for database configuration."""
    return {
        "DB_PATH": os.getenv("DB_PATH", "metrics.db"),
        "LOG_FILE": os.getenv("LOG_FILE", "server.log"),
        "DB_HOST": os.getenv("DB_HOST", "localhost"),
        "DB_PORT": os.getenv("DB_PORT", "5432"),
        "DB_USER": os.getenv("DB_USER", "admin"),
        "DB_PASS": os.getenv("DB_PASS", "password123"),
    }

def parse_log_line(line: str) -> Dict:
    """Parse a log line using regex and return structured data."""
    log_pattern = r"(?P<dt>[\d\-]+\s[\d\:]+)\s(?P<level>[A-Z]+)\s(?P<message>.+)"
    match = re.match(log_pattern, line)
    if match:
        return {
            "dt": match.group("dt"),
            "level": match.group("level"),
            "message": match.group("message")
        }
    return {}

def process_log_file(log_file: str) -> List[Dict]:
    """Process the server log file and return a list of parsed log entries."""
    entries = []
    if os.path.exists(log_file):
        with open(log_file, "r") as f:
            for line in f:
                parsed_line = parse_log_line(line)
                if parsed_line:
                    entries.append(parsed_line)
    return entries

def classify_log_entries(entries: List[Dict]) -> (List[Dict], Dict[str, int], List[Dict]):
    """Classify the log entries into errors, session actions, and API calls."""
    d_list = []
    sessions = {}
    api_calls = []

    for entry in entries:
        dt = entry["dt"]
        level = entry["level"]
        message = entry["message"]

        if level == "ERROR":
            d_list.append({"d": dt, "t": "ERR", "m": message})

        elif level == "INFO":
            if "User" in message:
                uid = re.search(r"User (\d+)", message).group(1)
                action = message.split("User " + uid + " ")[1].strip()

                if "logged in" in action:
                    sessions[uid] = dt
                elif "logged out" in action and uid in sessions:
                    sessions.pop(uid)
                d_list.append({"d": dt, "t": "USR", "u": uid, "a": action})

            elif "API" in message:
                endpoint = re.search(r"API (.+?) ", message).group(1)
                dur = re.search(r"took (\d+)ms", message)
                duration = int(dur.group(1)) if dur else 0
                api_calls.append({"d": dt, "endpoint": endpoint, "ms": duration})

    return d_list, sessions, api_calls

def insert_error_counts(db_conn: sqlite3.Connection, error_counts: Dict[str, int]):
    """Insert error message counts into the database."""
    cursor = db_conn.cursor()
    for msg, count in error_counts.items():
        cursor.execute("INSERT INTO errors (dt, message, count) VALUES (?, ?, ?)",
                       (datetime.datetime.now(), msg, count))

def insert_api_metrics(db_conn: sqlite3.Connection, api_calls: List[Dict]):
    """Calculate and insert API metrics into the database."""
    endpoint_stats = {}
    for call in api_calls:
        ep = call["endpoint"]
        endpoint_stats.setdefault(ep, []).append(call["ms"])

    cursor = db_conn.cursor()
    for ep, times in endpoint_stats.items():
        avg = sum(times) / len(times)
        cursor.execute("INSERT INTO api_metrics (dt, endpoint, avg_ms) VALUES (?, ?, ?)",
                       (datetime.datetime.now(), ep, avg))

def generate_report(error_counts: Dict[str, int], api_calls: List[Dict], active_sessions: int):
    """Generate the HTML report from processed data."""
    out = "<html>\n<head><title>System Report</title></head>\n<body>\n"
    out += "<h1>Error Summary</h1>\n<ul>\n"
    for err_msg, count in error_counts.items():
        out += f"<li><b>{err_msg}</b>: {count} occurrences</li>\n"
    out += "</ul>\n"

    out += "<h2>API Latency</h2>\n<table border='1'>\n"
    out += "<tr><th>Endpoint</th><th>Avg (ms)</th></tr>\n"
    for call in api_calls:
        avg = call["ms"]
        out += f"<tr><td>{call['endpoint']}</td><td>{avg}</td></tr>\n"
    out += "</table>\n"

    out += f"<h2>Active Sessions</h2>\n<p>{active_sessions} user(s) currently active</p>\n"
    out += "</body>\n</html>"

    with open("report.html", "w") as f:
        f.write(out)

def proc_data():
    """Main processing function. Extracts data from logs, transforms it, and loads it into a database."""
    env_vars = get_env_variables()
    db_path = env_vars["DB_PATH"]
    log_file = env_vars["LOG_FILE"]

    entries = process_log_file(log_file)
    d_list, sessions, api_calls = classify_log_entries(entries)

    print("Connecting to database...")
    conn = sqlite3.connect(db_path)
    conn.execute("CREATE TABLE IF NOT EXISTS errors (dt TEXT, message TEXT, count INTEGER)")
    conn.execute("CREATE TABLE IF NOT EXISTS api_metrics (dt TEXT, endpoint TEXT, avg_ms REAL)")

    error_counts = {}
    for entry in d_list:
        if entry["t"] == "ERR":
            msg = entry["m"]
            error_counts[msg] = error_counts.get(msg, 0) + 1

    insert_error_counts(conn, error_counts)
    insert_api_metrics(conn, api_calls)

    conn.commit()
    conn.close()

    generate_report(error_counts, api_calls, len(sessions))
    print("Job finished at " + str(datetime.datetime.now()))

if __name__ == "__main__":
    proc_data()
```

### Changes Made:
1. **Environment Variables**: Used `os.getenv` to obtain database configuration and log file path.
2. **Parameterized Queries**: Used parameterized queries to prevent SQL injection.
3. **Function Organization**: Separated the logic into distinct functions for better readability and maintainability following the Extract, Transform, Load design pattern.
4. **Regex for Parsing**: Implemented regex to safely parse logs instead of string manipulation.
5. **Type Hints and Docstrings**: Added type hints and added docstrings for better understanding and documentation.

### Verification:
This refactoring maintains the same output format (the HTML report) while improving security, maintainability, and clarity. You may want to run it by ensuring proper configuration is set in your environment variables.
