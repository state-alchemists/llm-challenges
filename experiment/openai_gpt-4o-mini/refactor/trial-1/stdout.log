### New Structure

- **`main()`**: The entry point for the script.
- **`load_config()`**: Loads configuration from environment variables.
- **`extract_logs()`**: Extracts logs from the specified log file.
- **`transform_data()`**: Processes extracted logs into structured data (errors and sessions).
- **`load_to_db()`**: Loads processed data into the SQLite database.
- **`generate_report()`**: Generates and saves the HTML report.

### Refactored Code

Here's the refactored `pipeline_refactored.py` code:

```python
import datetime
import os
import sqlite3
import re
from typing import List, Dict, Any, Tuple

def load_config() -> Dict[str, str]:
    """Load configuration from environment variables."""
    return {
        "DB_PATH": os.getenv("DB_PATH", "metrics.db"),
        "LOG_FILE": os.getenv("LOG_FILE", "server.log"),
        "DB_HOST": os.getenv("DB_HOST", "localhost"),
        "DB_PORT": os.getenv("DB_PORT", "5432"),
        "DB_USER": os.getenv("DB_USER", "admin"),
        "DB_PASS": os.getenv("DB_PASS", "password123"),
    }

def extract_logs(log_file: str) -> List[str]:
    """Extracts log lines from the specified log file."""
    if not os.path.exists(log_file):
        raise FileNotFoundError(f"Log file not found: {log_file}")

    with open(log_file, "r") as file:
        return file.readlines()

def transform_data(log_lines: List[str]) -> Tuple[List[Dict[str, Any]], Dict[str, str], List[Dict[str, Any]]]:
    """Transforms log lines into structured data for errors and API calls."""
    errors = []
    sessions = {}
    api_calls = []
    
    log_pattern = re.compile(r'^(?P<datetime>[\S\s]+) (?P<level>\S+) (?P<msg>.+)$')
    
    for line in log_lines:
        match = log_pattern.match(line)
        if match:
            dt = match.group('datetime').strip()
            lvl = match.group('level').strip()
            msg = match.group('msg').strip()

            if lvl == "ERROR":
                errors.append({"d": dt, "t": "ERR", "m": msg})
            elif lvl == "INFO":
                if "User" in msg:
                    uid = msg.split("User ")[1].split(" ")[0]
                    action = msg.split("User " + uid + " ")[1].strip()

                    if "logged in" in action:
                        sessions[uid] = dt
                    elif "logged out" in action and uid in sessions:
                        sessions.pop(uid)
                    errors.append({"d": dt, "t": "USR", "u": uid, "a": action})
                elif "API" in msg:
                    endpoint = msg.split("API ")[1].split(" ")[0]
                    dur = re.search(r'took (\d+)ms', msg)
                    dur = int(dur.group(1)) if dur else 0
                    api_calls.append({"d": dt, "endpoint": endpoint, "ms": dur})
            elif lvl == "WARN":
                errors.append({"d": dt, "t": "WARN", "m": msg})

    return errors, sessions, api_calls

def load_to_db(db_path: str, error_data: List[Dict[str, Any]], api_call_data: List[Dict[str, Any]]) -> None:
    """Load structured data into the SQLite database."""
    conn = sqlite3.connect(db_path)
    c = conn.cursor()

    c.execute("CREATE TABLE IF NOT EXISTS errors (dt TEXT, message TEXT, count INTEGER)")
    c.execute("CREATE TABLE IF NOT EXISTS api_metrics (dt TEXT, endpoint TEXT, avg_ms REAL)")

    error_counts = {}
    for error in error_data:
        if error["t"] == "ERR":
            msg = error["m"]
            error_counts[msg] = error_counts.get(msg, 0) + 1

    for msg, count in error_counts.items():
        c.execute("INSERT INTO errors (dt, message, count) VALUES (?, ?, ?)",
                  (datetime.datetime.now(), msg, count))

    endpoint_stats = {}
    for call in api_call_data:
        ep = call["endpoint"]
        endpoint_stats.setdefault(ep, []).append(call["ms"])

    for ep, times in endpoint_stats.items():
        avg = sum(times) / len(times)
        c.execute("INSERT INTO api_metrics (dt, endpoint, avg_ms) VALUES (?, ?, ?)",
                  (datetime.datetime.now(), ep, avg))

    conn.commit()
    conn.close()

def generate_report(error_data: List[Dict[str, Any]], api_call_data: List[Dict[str, Any]], sessions: Dict[str, str]) -> None:
    """Generates an HTML report."""
    out = "<html>\n<head><title>System Report</title></head>\n<body>\n"
    out += "<h1>Error Summary</h1>\n<ul>\n"
    
    error_counts = {}
    for err_msg in error_data:
        if err_msg["t"] == "ERR":
            msg = err_msg["m"]
            error_counts[msg] = error_counts.get(msg, 0) + 1

    for err_msg, count in error_counts.items():
        out += f"<li><b>{err_msg}</b>: {count} occurrences</li>\n"
    out += "</ul>\n"

    out += "<h2>API Latency</h2>\n<table border='1'>\n"
    out += "<tr><th>Endpoint</th><th>Avg (ms)</th></tr>\n"
    
    endpoint_stats = {}
    for call in api_call_data:
        ep = call["endpoint"]
        endpoint_stats.setdefault(ep, []).append(call["ms"])
    
    for ep, times in endpoint_stats.items():
        avg = sum(times) / len(times)
        out += f"<tr><td>{ep}</td><td>{round(avg, 1)}</td></tr>\n"
    out += "</table>\n"

    out += "<h2>Active Sessions</h2>\n"
    out += f"<p>{len(sessions)} user(s) currently active</p>\n"
    out += "</body>\n</html>"

    with open("report.html", "w") as f:
        f.write(out)

def main() -> None:
    """Main entry point of the script."""
    config = load_config()
    log_lines = extract_logs(config["LOG_FILE"])
    error_data, sessions, api_call_data = transform_data(log_lines)
    load_to_db(config["DB_PATH"], error_data, api_call_data)
    generate_report(error_data, api_call_data, sessions)
    print("Job finished at", str(datetime.datetime.now()))

if __name__ == "__main__":
    main()
```

### Key Changes
1. **Environment Variables**: The configuration is now dynamic and can be set via environment variables.
2. **Parameterized SQL**: SQL insertion is done using parameterized queries to prevent SQL injection vulnerabilities.
3. **ETL Functions**: Each major step is now encapsulated in a dedicated function, promoting clarity and maintainability.
4. **Regular Expressions**: Improved log parsing logic with regex for better flexibility.
5. **Type Hints and Docstrings**: Added clarity on function inputs and outputs for better understanding.

This refactored code maintains the same functionalities and ensures improved security and maintainability. If you need further enhancements or modifications, please let me know!
