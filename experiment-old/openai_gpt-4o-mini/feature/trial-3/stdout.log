### Step 1: Implement `require_api_key` in `app/auth.py`
This function will read the `X-API-Key` header, validate it against the `VALID_API_KEYS` found in `database.py`, and raise an HTTP 401 error if invalid.

```python
# app/auth.py

from fastapi import Security, HTTPException
from fastapi.security import APIKeyHeader
from .database import VALID_API_KEYS  # Ensure VALID_API_KEYS is imported

api_key_header = APIKeyHeader(name="X-API-Key")

def require_api_key(api_key: str = Security(api_key_header)):
    if api_key not in VALID_API_KEYS:
        raise HTTPException(status_code=401, detail="Invalid API Key")
```

### Step 2: Modify `GET /tasks` in `app/main.py`
Add filtering and pagination logic for the `GET /tasks` endpoint.

```python
# app/main.py

from fastapi import FastAPI, Depends
from typing import List, Optional
from .auth import require_api_key  # Import the authentication dependency
from .database import get_tasks, Task  # Assuming get_tasks fetches tasks from the database

app = FastAPI()

# Define a function to filter tasks based on provided parameters
def filter_tasks(status: Optional[str] = None, priority: Optional[int] = None, assigned_to: Optional[str] = None, page: int = 1, page_size: int = 20) -> List[Task]:
    tasks = get_tasks()  # Fetch all tasks first
    if status:
        tasks = [task for task in tasks if task.status == status]
    if priority:
        tasks = [task for task in tasks if task.priority == priority]
    if assigned_to:
        tasks = [task for task in tasks if task.assigned_to == assigned_to]
    # Implement pagination
    start_index = (page - 1) * page_size
    end_index = start_index + page_size
    return tasks[start_index:end_index]

@app.get("/tasks", response_model=List[Task])
def get_tasks_endpoint(status: Optional[str] = None, priority: Optional[int] = None, assigned_to: Optional[str] = None, page: int = 1, page_size: int = 20):
    return filter_tasks(status, priority, assigned_to, page, page_size)
```

### Step 3: Implement `POST /tasks`
Create a new task while ensuring it requires authentication.

```python
# app/main.py

from pydantic import BaseModel
from fastapi import HTTPException, status

class TaskCreate(BaseModel):
    title: str
    project_id: int
    priority: int
    assigned_to: str

@app.post("/tasks", response_model=Task)
def create_task(task_create: TaskCreate, api_key: str = Depends(require_api_key)):
    # Validate project_id
    if not project_exists(task_create.project_id):  # Check if project_id is valid
        raise HTTPException(status_code=404, detail="Project not found")

    new_task_id = generate_unique_id()  # Assume a method to generate a unique ID
    task = Task(id=new_task_id, title=task_create.title, project_id=task_create.project_id, status="Pending", priority=task_create.priority, assigned_to=task_create.assigned_to)
    save_task(task)  # Assume a method to save the newly created task to the database
    return task
```

### Step 4: Implement `PUT /tasks/{task_id}`
Allow partial updates to a task.

```python
# app/main.py

@app.put("/tasks/{task_id}", response_model=Task)
def update_task(task_id: int, task_update: TaskCreate, api_key: str = Depends(require_api_key)):
    task = get_task_by_id(task_id)  # Retrieve the task by ID
    if not task:
        raise HTTPException(status_code=404, detail="Task not found")

    # Update task fields as necessary
    if task_update.title:
        task.title = task_update.title
    if task_update.priority:
        task.priority = task_update.priority
    if task_update.assigned_to:
        task.assigned_to = task_update.assigned_to
    # Persist changes to database
    save_task(task)
    return task
```

