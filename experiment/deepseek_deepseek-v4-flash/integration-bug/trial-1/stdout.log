[0m  [2mSIMULATION_SCRIPT = r"""
[0m  [2mimport asyncio, json, random, sys, traceback
[0m  [2msys.path.insert(0, ".")
[0m  [2m
[0m  [2mtry:
[0m  [2m    from inventory import Inventory
[0m  [2m    from payments import PaymentGateway
[0m  [2m    from checkout import checkout
[0m  [2mexcept Exception:
