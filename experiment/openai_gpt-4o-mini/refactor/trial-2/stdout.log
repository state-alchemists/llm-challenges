```python
import os
import re
import sqlite3
import datetime
from typing import List, Dict, Tuple

# Load environment variables for configuration
DB_PATH = os.environ.get("DB_PATH", "metrics.db")
LOG_FILE = os.environ.get("LOG_FILE", "server.log")
DB_HOST = os.environ.get("DB_HOST", "localhost")
DB_PORT = int(os.environ.get("DB_PORT", 5432))
DB_USER = os.environ.get("DB_USER", "admin")
DB_PASS = os.environ.get("DB_PASS", "password123")

def parse_log_line(line: str) -> Dict[str, str]:
    """Parse a single line of the log file and return structured data."""
    log_pattern = re.compile(r'(?P<date>\S+ \S+) (?P<level>\w+) (?P<message>.*)')
    match = log_pattern.match(line)
    if match:
        return {
            'date': match.group('date'),
            'level': match.group('level'),
            'message': match.group('message')
        }
    return {}

def extract_logs(log_file: str) -> List[Dict[str, str]]:
    """Extract and parse logs from the specified log file."""
    log_entries = []
    if os.path.exists(log_file):
        with open(log_file, 'r') as f:
            for line in f:
                parsed_line = parse_log_line(line)
                if parsed_line:
                    log_entries.append(parsed_line)
    return log_entries

def transform_logs(log_entries: List[Dict[str, str]]) -> Tuple[List[Dict[str, str]], Dict[str, int], Dict[str, List[int]]]:
    """Transform log entries into structured summaries."""
    sessions = {}
    error_summary = {}
    api_calls = {}

    for entry in log_entries:
        level = entry['level']
        message = entry['message']
        timestamp = entry['date']

        if level == "ERROR":
            error_summary[message] = error_summary.get(message, 0) + 1
        elif level == "INFO":
            if "User" in message:
                user_id = message.split("User ")[1].split()[0]
                action = message.split(f"User {user_id} ")[1].strip()
                if "logged in" in action:
                    sessions[user_id] = timestamp
                elif "logged out" in action and user_id in sessions:
                    sessions.pop(user_id)
            elif "API" in message:
                endpoint = message.split("API ")[1].split()[0]
                duration = int(re.search(r'took (\d+)ms', message).group(1) or 0)
                if endpoint not in api_calls:
                    api_calls[endpoint] = []
                api_calls[endpoint].append(duration)

    return sessions, error_summary, api_calls

def load_data(api_calls: Dict[str, List[int]], error_summary: Dict[str, int]):
    """Load error and API call data into the database."""
    with sqlite3.connect(DB_PATH) as conn:
        cursor = conn.cursor()
        cursor.execute("CREATE TABLE IF NOT EXISTS errors (dt TEXT, message TEXT, count INTEGER)")
        cursor.execute("CREATE TABLE IF NOT EXISTS api_metrics (dt TEXT, endpoint TEXT, avg_ms REAL)")

        timestamp = datetime.datetime.now()
        
        for message, count in error_summary.items():
            cursor.execute("INSERT INTO errors VALUES (?, ?, ?)", (timestamp, message, count))

        for endpoint, durations in api_calls.items():
            avg_duration = sum(durations) / len(durations) if durations else 0.0
            cursor.execute("INSERT INTO api_metrics VALUES (?, ?, ?)", (timestamp, endpoint, avg_duration))


def generate_report(sessions: Dict[str, str], error_summary: Dict[str, int], api_calls: Dict[str, List[int]], output_file: str):
    """Generate an HTML report of the processed data."""
    output = "<html>\n<head><title>System Report</title></head>\n<body>\n"
    output += "<h1>Error Summary</h1>\n<ul>\n"
    for err_msg, count in error_summary.items():
        output += f"<li><b>{err_msg}</b>: {count} occurrences</li>\n"
    output += "</ul>\n"

    output += "<h2>API Latency</h2>\n<table border='1'>\n"
    output += "<tr><th>Endpoint</th><th>Avg (ms)</th></tr>\n"
    for endpoint, durations in api_calls.items():
        avg = sum(durations) / len(durations) if durations else 0.0
        output += f"<tr><td>{endpoint}</td><td>{round(avg, 1)}</td></tr>\n"
    output += "</table>\n"

    output += "<h2>Active Sessions</h2>\n"
    output += f"<p>{len(sessions)} user(s) currently active</p>\n"
    output += "</body>\n</html>"

    with open(output_file, "w") as f:
        f.write(output)


def main():
    """Main function to execute the ETL process."""
    log_entries = extract_logs(LOG_FILE)
    sessions, error_summary, api_calls = transform_logs(log_entries)
    load_data(api_calls, error_summary)
    generate_report(sessions, error_summary, api_calls, "report.html")
    print("Job finished at " + str(datetime.datetime.now()))


if __name__ == "__main__":
    if not os.path.exists(LOG_FILE):
        with open(LOG_FILE, "w") as f:
            f.write("2024-01-01 12:00:00 INFO User 42 logged in\n")
            f.write("2024-01-01 12:05:00 ERROR Database timeout\n")
            f.write("2024-01-01 12:05:05 ERROR Database timeout\n")
            f.write("2024-01-01 12:08:00 INFO API /users/profile took 250ms\n")
            f.write("2024-01-01 12:09:00 WARN Memory usage at 87%\n")
            f.write("2024-01-01 12:10:00 INFO User 42 logged out\n")
    main()
```

### Summary of Changes:
- **Environment Variables**: Credentials and paths are now fetched from environment variables.
- **Parameterization**: SQL queries use parameterized commands to mitigate injection risks.
- **Function Decomposition**: Logic has been divided into several clear, well-named functions.
- **Regular Expressions**: Regex is used for more robust log parsing.
- **Type Hints and Docstrings**: Added type hints for functions and docstrings for better documentation.

You can run this refactored script in your Python environment, ensuring that the necessary environment variables are set.
